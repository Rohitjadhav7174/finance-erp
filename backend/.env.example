# Backend settings — PLACEHOLDERS ONLY. Copy to backend/.env (git-ignored) and fill in.
# Never commit real values. In production set these in the hosting provider's secret settings.

ENVIRONMENT=development            # development | production

# Postgres connection for the API. In production use the `app_api` login role (NOT postgres / service role):
#   postgresql://app_api.YOUR-PROJECT-REF:YOUR-APP-API-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=host=localhost port=54329 user=postgres dbname=finance_dev
# Local development ONLY (connect as superuser, then act as app_api). Must be empty in production.
DB_SET_ROLE=app_api

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Only for projects still using the legacy HS256 JWT secret; leave empty for JWT signing keys (JWKS).
SUPABASE_JWT_SECRET=
# Server-side only: used to invite and disable employees. NEVER put this in the frontend.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

CORS_ORIGINS=["http://localhost:5173"]
RATE_LIMIT_DEFAULT=600/minute
RATE_LIMIT_SENSITIVE=20/minute
